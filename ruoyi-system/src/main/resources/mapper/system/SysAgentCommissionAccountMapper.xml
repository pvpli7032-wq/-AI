<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysAgentCommissionAccountMapper">
    
    <resultMap type="com.ruoyi.system.domain.SysAgentCommissionAccount" id="SysAgentCommissionAccountResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="totalEarned"    column="total_earned"    />
        <result property="selfEarned"    column="self_earned"    />
        <result property="promotionEarned"    column="promotion_earned"    />
        <result property="balance"    column="balance"    />
        <result property="withdrawn"    column="withdrawn"    />
        <result property="frozenAmount"    column="frozen_amount"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysAgentCommissionAccountVo">
        select id, user_id, total_earned, self_earned, promotion_earned, 
               balance, withdrawn, frozen_amount, status, create_time, update_time
        from sys_agent_commission_account
    </sql>

    <select id="selectSysAgentCommissionAccountList" parameterType="com.ruoyi.system.domain.SysAgentCommissionAccount" resultMap="SysAgentCommissionAccountResult">
        <include refid="selectSysAgentCommissionAccountVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectSysAgentCommissionAccountById" parameterType="Long" resultMap="SysAgentCommissionAccountResult">
        <include refid="selectSysAgentCommissionAccountVo"/>
        where id = #{id}
    </select>

    <select id="selectSysAgentCommissionAccountByUserId" parameterType="Long" resultMap="SysAgentCommissionAccountResult">
        <include refid="selectSysAgentCommissionAccountVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="SysAgentCommissionAccountResult">
        <include refid="selectSysAgentCommissionAccountVo"/>
        where user_id = #{userId}
    </select>

    <insert id="ensureAccount">
        insert into sys_agent_commission_account (user_id, status, create_time)
        values (#{userId}, '0', current_timestamp)
        on duplicate key update id = id
    </insert>

    <select id="selectByUserIdForUpdate" resultMap="SysAgentCommissionAccountResult" useCache="false" flushCache="true">
        <include refid="selectSysAgentCommissionAccountVo"/>
        where user_id = #{userId} for update
    </select>

    <!-- 本线不修改订单Mapper；在入账边界补齐结算所需字段，并使用锁定读。 -->
    <resultMap id="PostingOrderResult" type="com.ruoyi.system.domain.SysOrderCommission"
               extends="com.ruoyi.system.mapper.SysOrderCommissionMapper.SysOrderCommissionResult">
        <result property="buyerUserId" column="buyer_user_id"/>
        <result property="estimatedCommission" column="estimated_commission"/>
        <result property="commissionRate" column="commission_rate"/>
        <result property="actualCommission" column="actual_commission"/>
        <result property="settleStatus" column="settle_status"/>
        <result property="orderTime" column="order_time"/>
    </resultMap>

    <select id="selectOrderCommissionForUpdate" resultMap="PostingOrderResult" useCache="false" flushCache="true">
        select * from sys_order_commission where id = #{id} for update
    </select>

    <update id="updateOrderSettlement" parameterType="com.ruoyi.system.domain.SysOrderCommission">
        update sys_order_commission
        set actual_commission = #{actualCommission}, self_commission_amount = #{selfCommissionAmount},
            promotion_commission_amount = #{promotionCommissionAmount}, order_status = #{orderStatus},
            settle_status = #{settleStatus}, settle_time = #{settleTime}, update_time = #{updateTime}
        where id = #{id}
    </update>

    <update id="updateAccountStatus">
        update sys_agent_commission_account set status = #{status}, update_time = current_timestamp
        where id = #{id}
    </update>

    <insert id="insertSysAgentCommissionAccount" parameterType="com.ruoyi.system.domain.SysAgentCommissionAccount" useGeneratedKeys="true" keyProperty="id">
        insert into sys_agent_commission_account
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="totalEarned != null">total_earned,</if>
            <if test="selfEarned != null">self_earned,</if>
            <if test="promotionEarned != null">promotion_earned,</if>
            <if test="balance != null">balance,</if>
            <if test="withdrawn != null">withdrawn,</if>
            <if test="frozenAmount != null">frozen_amount,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="totalEarned != null">#{totalEarned},</if>
            <if test="selfEarned != null">#{selfEarned},</if>
            <if test="promotionEarned != null">#{promotionEarned},</if>
            <if test="balance != null">#{balance},</if>
            <if test="withdrawn != null">#{withdrawn},</if>
            <if test="frozenAmount != null">#{frozenAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysAgentCommissionAccount" parameterType="com.ruoyi.system.domain.SysAgentCommissionAccount">
        update sys_agent_commission_account
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="totalEarned != null">total_earned = #{totalEarned},</if>
            <if test="selfEarned != null">self_earned = #{selfEarned},</if>
            <if test="promotionEarned != null">promotion_earned = #{promotionEarned},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="withdrawn != null">withdrawn = #{withdrawn},</if>
            <if test="frozenAmount != null">frozen_amount = #{frozenAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysAgentCommissionAccountById" parameterType="Long">
        delete from sys_agent_commission_account where id = #{id}
    </delete>

    <delete id="deleteSysAgentCommissionAccountByIds" parameterType="String">
        delete from sys_agent_commission_account where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
