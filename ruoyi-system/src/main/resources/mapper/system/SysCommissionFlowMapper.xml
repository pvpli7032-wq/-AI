<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysCommissionFlowMapper">
    
    <resultMap type="com.ruoyi.system.domain.SysCommissionFlow" id="SysCommissionFlowResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="flowType"    column="flow_type"    />
        <result property="amount"    column="amount"    />
        <result property="balanceBefore"    column="balance_before"    />
        <result property="balanceAfter"    column="balance_after"    />
        <result property="orderCommissionId"    column="order_commission_id"    />
        <result property="relatedOrderId"    column="related_order_id"    />
        <result property="description"    column="description"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectSysCommissionFlowVo">
        select id, user_id, flow_type, amount, balance_before, balance_after, 
               order_commission_id, related_order_id, description, create_time
        from sys_commission_flow
    </sql>

    <select id="selectSysCommissionFlowList" parameterType="com.ruoyi.system.domain.SysCommissionFlow" resultMap="SysCommissionFlowResult">
        <include refid="selectSysCommissionFlowVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="flowType != null  and flowType != ''"> and flow_type = #{flowType}</if>
            <if test="relatedOrderId != null "> and related_order_id = #{relatedOrderId}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != ''">
                and create_time &gt;= #{params.beginCreateTime}
            </if>
            <if test="params.endCreateTime != null and params.endCreateTime != ''">
                and create_time &lt;= #{params.endCreateTime}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectSysCommissionFlowById" parameterType="Long" resultMap="SysCommissionFlowResult">
        <include refid="selectSysCommissionFlowVo"/>
        where id = #{id}
    </select>

    <select id="selectByBusinessKey" resultMap="SysCommissionFlowResult" useCache="false" flushCache="true">
        <include refid="selectSysCommissionFlowVo"/>
        where user_id = #{userId} and flow_type = #{flowType}
          and order_commission_id = #{orderCommissionId}
        for update
    </select>

    <insert id="insertSysCommissionFlow" parameterType="com.ruoyi.system.domain.SysCommissionFlow" useGeneratedKeys="true" keyProperty="id">
        insert into sys_commission_flow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="flowType != null and flowType != ''">flow_type,</if>
            <if test="amount != null">amount,</if>
            <if test="balanceBefore != null">balance_before,</if>
            <if test="balanceAfter != null">balance_after,</if>
            <if test="orderCommissionId != null">order_commission_id,</if>
            <if test="relatedOrderId != null">related_order_id,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="flowType != null and flowType != ''">#{flowType},</if>
            <if test="amount != null">#{amount},</if>
            <if test="balanceBefore != null">#{balanceBefore},</if>
            <if test="balanceAfter != null">#{balanceAfter},</if>
            <if test="orderCommissionId != null">#{orderCommissionId},</if>
            <if test="relatedOrderId != null">#{relatedOrderId},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <!-- 保留既有方法和接口；账务流水只能追加，纠错必须另记冲正分录。 -->
    <update id="updateSysCommissionFlow" parameterType="com.ruoyi.system.domain.SysCommissionFlow">
        signal sqlstate '45000' set message_text = 'Commission ledger is append-only; append a reversal instead'
    </update>

    <delete id="deleteSysCommissionFlowById" parameterType="Long">
        signal sqlstate '45000' set message_text = 'Commission ledger is append-only; append a reversal instead'
    </delete>

    <delete id="deleteSysCommissionFlowByIds" parameterType="String">
        signal sqlstate '45000' set message_text = 'Commission ledger is append-only; append a reversal instead'
    </delete>
</mapper>
