<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysOrderCommissionMapper">
    <select id="selectExistingFlowForUpdate" resultType="long" useCache="false" flushCache="true">
        select id from sys_commission_flow
        where order_commission_id = #{orderCommissionId}
           or related_order_id = cast(#{orderCommissionId} as char)
        limit 1 for update
    </select>
    
    <resultMap type="com.ruoyi.system.domain.SysOrderCommission" id="SysOrderCommissionResult">
        <result property="id"    column="id"    />
        <result property="orderId"    column="order_id"    />
        <result property="subOrderNo" column="sub_order_no" />
        <result property="rawStatus" column="raw_status" />
        <result property="pid" column="pid" />
        <result property="attributionToken" column="attribution_token" />
        <result property="paidTime" column="paid_time" />
        <result property="lineStatus" column="line_status" />
        <result property="receivedTime" column="received_time" />
        <result property="platformType"    column="platform_type"    />
        <result property="itemId"    column="item_id"    />
        <result property="itemTitle"    column="item_title"    />
        <result property="orderAmount"    column="order_amount"    />
        <result property="totalCommission"    column="total_commission"    />
        <result property="agentUserId"    column="agent_user_id"    />
        <result property="selfCommissionRate"    column="self_commission_rate"    />
        <result property="selfCommissionAmount"    column="self_commission_amount"    />
        <result property="hasReferrer"    column="has_referrer"    />
        <result property="referrerUserId"    column="referrer_user_id"    />
        <result property="promotionCommissionRate"    column="promotion_commission_rate"    />
        <result property="promotionCommissionAmount"    column="promotion_commission_amount"    />
        <result property="platformAmount"    column="platform_amount"    />
        <result property="orderStatus"    column="order_status"    />
        <result property="settleTime"    column="settle_time"    />
        <result property="estimatedCommission"    column="estimated_commission"    />
        <result property="commissionRate"    column="commission_rate"    />
        <result property="buyerUserId"    column="buyer_user_id"    />
        <result property="orderTime"    column="order_time"    />
        <result property="settleStatus"    column="settle_status"    />
        <result property="actualCommission"    column="actual_commission"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysOrderCommissionVo">
        select id, order_id, sub_order_no, received_time, raw_status, pid, attribution_token, paid_time, line_status, platform_type, item_id, item_title, order_amount,
               total_commission, agent_user_id, 
               self_commission_rate, self_commission_amount, 
               has_referrer, referrer_user_id,
               promotion_commission_rate, promotion_commission_amount, platform_amount,
               order_status, settle_time,
               estimated_commission, commission_rate, buyer_user_id, order_time,
               settle_status, actual_commission, remark,
               create_time, update_time
        from sys_order_commission
    </sql>

    <select id="selectSysOrderCommissionList" parameterType="com.ruoyi.system.domain.SysOrderCommission" resultMap="SysOrderCommissionResult">
        <include refid="selectSysOrderCommissionVo"/>
        <where>  
            <if test="orderId != null  and orderId != ''"> and order_id = #{orderId}</if>
            <if test="platformType != null  and platformType != ''"> and platform_type = #{platformType}</if>
            <if test="itemId != null  and itemId != ''"> and item_id = #{itemId}</if>
            <if test="buyerUserId != null "> and buyer_user_id = #{buyerUserId}</if>
            <if test="hasReferrer != null  and hasReferrer != ''"> and has_referrer = #{hasReferrer}</if>
            <if test="referrerUserId != null "> and referrer_user_id = #{referrerUserId}</if>
            <if test="orderStatus != null  and orderStatus != ''"> and order_status = #{orderStatus}</if>
            <if test="settleStatus != null  and settleStatus != ''"> and settle_status = #{settleStatus}</if>
            <if test="params.beginOrderTime != null and params.beginOrderTime != ''">
                and order_time &gt;= #{params.beginOrderTime}
            </if>
            <if test="params.endOrderTime != null and params.endOrderTime != ''">
                and order_time &lt;= #{params.endOrderTime}
            </if>
            <if test="params.beginSettleTime != null and params.beginSettleTime != ''">
                and settle_time &gt;= #{params.beginSettleTime}
            </if>
            <if test="params.endSettleTime != null and params.endSettleTime != ''">
                and settle_time &lt;= #{params.endSettleTime}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectSysOrderCommissionById" parameterType="Long" resultMap="SysOrderCommissionResult">
        <include refid="selectSysOrderCommissionVo"/>
        where id = #{id}
    </select>

    <!-- 旧入口仅服务无子单订单；线 10 接入后必须使用 selectByOrderLineKey。 -->
    <select id="selectSysOrderCommissionByOrderIdAndPlatformType" resultMap="SysOrderCommissionResult">
        <include refid="selectSysOrderCommissionVo"/>
        where order_id = #{orderId} and platform_type = #{platformType} and sub_order_no = ''
    </select>

    <!-- 完整订单行键；线 10 必须使用此入口。 -->
    <select id="selectByOrderLineKey" resultMap="SysOrderCommissionResult">
        <include refid="selectSysOrderCommissionVo"/>
        where order_id = #{orderId} and platform_type = #{platformType} and sub_order_no = #{subOrderNo}
    </select>

    <insert id="insertSysOrderCommission" parameterType="com.ruoyi.system.domain.SysOrderCommission" useGeneratedKeys="true" keyProperty="id">
        insert into sys_order_commission
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null and orderId != ''">order_id,</if>
            <if test="subOrderNo != null">sub_order_no,</if>
            <if test="rawStatus != null">raw_status,</if>
            <if test="pid != null">pid,</if>
            <if test="attributionToken != null">attribution_token,</if>
            <if test="paidTime != null">paid_time,</if>
            <if test="lineStatus != null">line_status,</if>
            <if test="receivedTime != null">received_time,</if>
            <if test="platformType != null and platformType != ''">platform_type,</if>
            <if test="itemId != null and itemId != ''">item_id,</if>
            <if test="itemTitle != null">item_title,</if>
            <if test="orderAmount != null">order_amount,</if>
            <if test="totalCommission != null">total_commission,</if>
            <if test="agentUserId != null">agent_user_id,</if>
            <if test="selfCommissionRate != null">self_commission_rate,</if>
            <if test="selfCommissionAmount != null">self_commission_amount,</if>
            <if test="hasReferrer != null">has_referrer,</if>
            <if test="referrerUserId != null">referrer_user_id,</if>
            <if test="promotionCommissionRate != null">promotion_commission_rate,</if>
            <if test="promotionCommissionAmount != null">promotion_commission_amount,</if>
            <if test="platformAmount != null">platform_amount,</if>
            <if test="orderStatus != null">order_status,</if>
            <if test="settleTime != null">settle_time,</if>
            <if test="estimatedCommission != null">estimated_commission,</if>
            <if test="commissionRate != null">commission_rate,</if>
            <if test="buyerUserId != null or agentUserId != null">buyer_user_id,</if>
            <if test="orderTime != null">order_time,</if>
            <if test="settleStatus != null">settle_status,</if>
            <if test="actualCommission != null">actual_commission,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null and orderId != ''">#{orderId},</if>
            <if test="subOrderNo != null">#{subOrderNo},</if>
            <if test="rawStatus != null">#{rawStatus},</if>
            <if test="pid != null">#{pid},</if>
            <if test="attributionToken != null">#{attributionToken},</if>
            <if test="paidTime != null">#{paidTime},</if>
            <if test="lineStatus != null">#{lineStatus},</if>
            <if test="receivedTime != null">#{receivedTime},</if>
            <if test="platformType != null and platformType != ''">#{platformType},</if>
            <if test="itemId != null and itemId != ''">#{itemId},</if>
            <if test="itemTitle != null">#{itemTitle},</if>
            <if test="orderAmount != null">#{orderAmount},</if>
            <if test="totalCommission != null">#{totalCommission},</if>
            <if test="agentUserId != null">#{agentUserId},</if>
            <if test="selfCommissionRate != null">#{selfCommissionRate},</if>
            <if test="selfCommissionAmount != null">#{selfCommissionAmount},</if>
            <if test="hasReferrer != null">#{hasReferrer},</if>
            <if test="referrerUserId != null">#{referrerUserId},</if>
            <if test="promotionCommissionRate != null">#{promotionCommissionRate},</if>
            <if test="promotionCommissionAmount != null">#{promotionCommissionAmount},</if>
            <if test="platformAmount != null">#{platformAmount},</if>
            <if test="orderStatus != null">#{orderStatus},</if>
            <if test="settleTime != null">#{settleTime},</if>
            <if test="estimatedCommission != null">#{estimatedCommission},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="buyerUserId != null or agentUserId != null">
                <choose>
                    <when test="buyerUserId != null">#{buyerUserId},</when>
                    <otherwise>#{agentUserId},</otherwise>
                </choose>
            </if>
            <if test="orderTime != null">#{orderTime},</if>
            <if test="settleStatus != null">#{settleStatus},</if>
            <if test="actualCommission != null">#{actualCommission},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysOrderCommission" parameterType="com.ruoyi.system.domain.SysOrderCommission">
        update sys_order_commission
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null and orderId != ''">order_id = #{orderId},</if>
            <if test="subOrderNo != null">sub_order_no = #{subOrderNo},</if>
            <if test="rawStatus != null">raw_status = #{rawStatus},</if>
            <if test="pid != null">pid = #{pid},</if>
            <if test="attributionToken != null">attribution_token = #{attributionToken},</if>
            <if test="paidTime != null">paid_time = #{paidTime},</if>
            <if test="lineStatus != null">line_status = #{lineStatus},</if>
            <if test="receivedTime != null">received_time = #{receivedTime},</if>
            <if test="platformType != null and platformType != ''">platform_type = #{platformType},</if>
            <if test="itemId != null and itemId != ''">item_id = #{itemId},</if>
            <if test="itemTitle != null">item_title = #{itemTitle},</if>
            <if test="orderAmount != null">order_amount = #{orderAmount},</if>
            <if test="totalCommission != null">total_commission = #{totalCommission},</if>
            <if test="agentUserId != null">agent_user_id = #{agentUserId},</if>
            <if test="selfCommissionRate != null">self_commission_rate = #{selfCommissionRate},</if>
            <if test="selfCommissionAmount != null">self_commission_amount = #{selfCommissionAmount},</if>
            <if test="hasReferrer != null">has_referrer = #{hasReferrer},</if>
            <if test="referrerUserId != null">referrer_user_id = #{referrerUserId},</if>
            <if test="promotionCommissionRate != null">promotion_commission_rate = #{promotionCommissionRate},</if>
            <if test="promotionCommissionAmount != null">promotion_commission_amount = #{promotionCommissionAmount},</if>
            <if test="platformAmount != null">platform_amount = #{platformAmount},</if>
            <if test="orderStatus != null">order_status = #{orderStatus},</if>
            <if test="settleTime != null">settle_time = #{settleTime},</if>
            <if test="estimatedCommission != null">estimated_commission = #{estimatedCommission},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="buyerUserId != null">buyer_user_id = #{buyerUserId},</if>
            <if test="orderTime != null">order_time = #{orderTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysOrderCommissionById" parameterType="Long">
        delete from sys_order_commission where id = #{id}
    </delete>

    <delete id="deleteSysOrderCommissionByIds" parameterType="String">
        delete from sys_order_commission where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
